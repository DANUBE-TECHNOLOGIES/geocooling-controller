# =====================================================
# ESPHOME NATIVE API — WT32 / DS18B20 READ-ONLY BRIDGE
# =====================================================
# sbc-core est confirmé à 192.168.10.105:6053.
# Le bridge écoute uniquement les états de capteurs via l'API native chiffrée.
# Il n'expose aucune commande ESPHome et ne touche pas aux actionneurs.
ESPHOME_BRIDGE_HOST=192.168.10.105
ESPHOME_BRIDGE_PORT=6053
ESPHOME_BRIDGE_NOISE_PSK=
ESPHOME_BRIDGE_RECONNECT_SECONDS=5

# =====================================================
# MÉTÉO / ANTICIPATION — OPEN-METEO — CHEVANNES 45210
