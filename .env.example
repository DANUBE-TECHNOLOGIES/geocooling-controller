# =====================================================
# GEOCOOLING CONTROLLER — SIMULATION
# =====================================================

GEOCOOLING_DRIVER=simulation
GEOCOOLING_VALVE_OPEN_DELAY=
GEOCOOLING_VALVE_CLOSE_DELAY=
GEOCOOLING_MAX_RUNTIME_SECONDS=

# =====================================================
# GEOCOOLING — MQTT DRIVER / DEVICE MANAGER
# =====================================================

# Conserver "simulation" tant que le matériel n'est pas raccordé.
# Valeurs possibles : simulation | mqtt | waveshare_modbus

GEOCOOLING_MQTT_CLIENT_ID=

GEOCOOLING_VALVE_COMMAND_TOPIC=
GEOCOOLING_VALVE_STATE_TOPIC=

GEOCOOLING_PUMP_COMMAND_TOPIC=
GEOCOOLING_PUMP_STATE_TOPIC=

GEOCOOLING_AVAILABILITY_TOPIC=
GEOCOOLING_HEARTBEAT_TOPIC=
GEOCOOLING_DEVICE_STATUS_TOPIC=

GEOCOOLING_COMMAND_ON_PAYLOAD=
GEOCOOLING_COMMAND_OFF_PAYLOAD=
GEOCOOLING_COMMAND_QOS=
GEOCOOLING_COMMAND_RETAIN=

GEOCOOLING_HEARTBEAT_TIMEOUT_SECONDS=

# =====================================================
# GEOCOOLING — MAPPING TÉLÉMÉTRIE RÉELLE
# =====================================================
# Les valeurs ci-dessous doivent correspondre exactement au champ
# sensor_name stocké dans sensor_measurements (endpoint /sensors/latest).
# Laisser vide tant que le capteur n'est pas identifié : le contrôleur
# conservera la mesure à null et la sécurité thermique restera fail-closed.
#
# Aucune affectation automatique n'est autorisée. Chaque sonde doit être
# confirmée physiquement avant de renseigner une variable ci-dessous.
#
# Obligatoire pour autoriser le refroidissement réel :
GEOCOOLING_SURFACE_SENSOR=
#
# Mesures hydrauliques / énergétiques :
GEOCOOLING_FLOOR_SUPPLY_SENSOR=
GEOCOOLING_FLOOR_RETURN_SENSOR=
GEOCOOLING_SOURCE_INLET_SENSOR=
GEOCOOLING_SOURCE_OUTLET_SENSOR=
GEOCOOLING_FLOW_SENSOR=
#
# Fraîcheur maximale acceptée pour chaque rôle télémétrique.
# Une mesure plus ancienne passe en état STALE et reste fail-closed.
GEOCOOLING_SENSOR_STALE_SECONDS=120
#
# Valeur de secours de débit uniquement si un débitmètre réel n'est pas présent.
# 0 = aucun débit supposé, donc puissance non calculable.
GEOCOOLING_FLOW_RATE_L_MIN=0
# Fraîcheur maximale d'un snapshot thermique en fonctionnement réel.
GEOCOOLING_THERMAL_MAX_AGE_SECONDS=180

# =====================================================
# DIGITAL TWIN / BUILDING STATE — SPRINT 006.2A
# =====================================================
BUILDING_REFRESH_INTERVAL_SECONDS=
BUILDING_INDOOR_MAX_AGE_SECONDS=
BUILDING_WEATHER_MAX_AGE_SECONDS=

# Sprint 006.2B — Device Framework
DEVICE_REFRESH_INTERVAL_SECONDS=
DEVICE_HEARTBEAT_TIMEOUT_SECONDS=

# Sprint 006.2C — Internal Event Bus
EVENT_BUS_QUEUE_SIZE=
EVENT_BUS_HISTORY_SIZE=
EVENT_BUS_BATCH_SIZE=
EVENT_BUS_FLUSH_SECONDS=
COMPOSE_FILE=

# PATCH C018 — Waveshare Modbus TCP (désarmé par défaut)
GEOCOOLING_WAVESHARE_HOST=
GEOCOOLING_WAVESHARE_PORT=502
GEOCOOLING_WAVESHARE_UNIT_ID=1
GEOCOOLING_WAVESHARE_ADDRESS_BASE=0
GEOCOOLING_WAVESHARE_VALVE_RELAY=1
GEOCOOLING_WAVESHARE_PUMP_RELAY=2
GEOCOOLING_WAVESHARE_TIMEOUT_SECONDS=
GEOCOOLING_WAVESHARE_RETRIES=
GEOCOOLING_WAVESHARE_RETRY_DELAY_SECONDS=
GEOCOOLING_WAVESHARE_VERIFY_WRITES=true

# Sécurité : aucune commande ON autorisée pendant le commissioning
GEOCOOLING_HARDWARE_ARMED=false
GEOCOOLING_HARDWARE_SEQUENCE_ENABLED=false
GEOCOOLING_AUTOPILOT_ENABLED=false
GEOCOOLING_AUTOPILOT_ALLOW_REAL_DRIVER=false
GEOCOOLING_SEQUENCE_DELAY_SECONDS=
GEOCOOLING_VERIFY_RELAY_STATE=
