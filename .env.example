# =====================================================
# ESPHOME NATIVE API — WT32 / DS18B20 READ-ONLY BRIDGE
# =====================================================
# sbc-core est confirmé à 192.168.10.105:6053.
# Le bridge écoute uniquement les états de capteurs via l'API native chiffrée.
# Il n'expose aucune commande ESPHome et ne touche pas aux actionneurs.
ESPHOME_BRIDGE_HOST=192.168.10.105
ESPHOME_BRIDGE_PORT=6053
ESPHOME_BRIDGE_NOISE_PSK=
ESPHOME_BRIDGE_RECONNECT_SECONDS=5

# =====================================================
# MÉTÉO / ANTICIPATION — OPEN-METEO — CHEVANNES 45210
# =====================================================
# Le service est strictement en lecture seule. Il fournit conditions actuelles
# + prévisions horaires au prédicteur RC3 Weather/Inertia. Il ne pilote jamais
# EV, M11/M13 ou le Waveshare.
GEOCOOLING_WEATHER_LOCATION=Chevannes
GEOCOOLING_WEATHER_POSTAL_CODE=45210
GEOCOOLING_WEATHER_COUNTRY_CODE=FR
GEOCOOLING_WEATHER_LATITUDE=
GEOCOOLING_WEATHER_LONGITUDE=
GEOCOOLING_WEATHER_TIMEZONE=Europe/Paris
GEOCOOLING_WEATHER_CACHE_SECONDS=900
GEOCOOLING_WEATHER_FORECAST_HOURS=48
GEOCOOLING_WEATHER_FORECAST_DAYS=7
GEOCOOLING_WEATHER_TIMEOUT_SECONDS=12

# =====================================================
# INTELLIGENCE THERMIQUE
# =====================================================
INTELLIGENCE_REFRESH_SECONDS=
COMFORT_TARGET_TEMPERATURE=
COMFORT_MAX_TEMPERATURE=
COMFORT_MIN_TEMPERATURE=
CONDENSATION_MARGIN_C=
GECOOLING_ESTIMATED_RATE=
THERMAL_MODEL_MIN_SAMPLES=

# =====================================================
# GEOCOOLING CONTROLLER — SIMULATION
# =====================================================

GEOCOOLING_DRIVER=simulation
GEOCOOLING_VALVE_OPEN_DELAY=
GEOCOOLING_VALVE_CLOSE_DELAY=
GEOCOOLING_MAX_RUNTIME_SECONDS=

# =====================================================
# GEOCOOLING — MQTT DRIVER / DEVICE MANAGER
# =====================================================

# Conserver "simulation" tant que le matériel n'est pas raccordé.
# Valeurs possibles : simulation | mqtt | waveshare_modbus

GEOCOOLING_MQTT_CLIENT_ID=

GEOCOOLING_VALVE_COMMAND_TOPIC=
GEOCOOLING_VALVE_STATE_TOPIC=

GEOCOOLING_PUMP_COMMAND_TOPIC=
GEOCOOLING_PUMP_STATE_TOPIC=

GEOCOOLING_AVAILABILITY_TOPIC=
GEOCOOLING_HEARTBEAT_TOPIC=
GEOCOOLING_DEVICE_STATUS_TOPIC=

GEOCOOLING_COMMAND_ON_PAYLOAD=
GEOCOOLING_COMMAND_OFF_PAYLOAD=
GEOCOOLING_COMMAND_QOS=
GEOCOOLING_COMMAND_RETAIN=

GEOCOOLING_HEARTBEAT_TIMEOUT_SECONDS=

# =====================================================
# GEOCOOLING — MAPPING TÉLÉMÉTRIE RÉELLE
# =====================================================
# Quatre DS18B20 physiques confirmées sur le WT32 :
# - Arrivée Forage  -> gc_source_inlet
# - Retour Forage   -> gc_source_outlet
# - Départ Plancher -> gc_floor_supply
# - Retour Plancher -> gc_floor_return
#
# Le site ne possède ni sonde de surface de plancher ni débitmètre.
# La sécurité anti-condensation peut utiliser explicitement une référence de
# surface dérivée de la moyenne départ/retour plancher, avec biais conservateur.
# Le débit reste optionnel : son absence interdit seulement le calcul précis
# de puissance/énergie, pas la sécurité anti-condensation.
GEOCOOLING_SENSOR_IDENTIFICATION_CONFIRMED=false

GEOCOOLING_SURFACE_SENSOR=
# sensor | floor_loop_estimate
# Laisser "sensor" tant que la stratégie dérivée n'a pas été validée.
GEOCOOLING_SURFACE_REFERENCE_MODE=sensor
# Biais appliqué à (départ + retour)/2. Toujours <= 0 dans le code.
# -0.5°C rend la référence plus froide et donc le gate plus restrictif.
GEOCOOLING_SURFACE_ESTIMATION_BIAS_C=-0.5

GEOCOOLING_FLOOR_SUPPLY_SENSOR=gc_floor_supply
GEOCOOLING_FLOOR_RETURN_SENSOR=gc_floor_return
GEOCOOLING_SOURCE_INLET_SENSOR=gc_source_inlet
GEOCOOLING_SOURCE_OUTLET_SENSOR=gc_source_outlet
GEOCOOLING_FLOW_SENSOR=
# false sur le site actuel : aucun débitmètre installé.
GEOCOOLING_FLOW_REQUIRED=false

# Fraîcheur maximale acceptée pour chaque rôle télémétrique.
GEOCOOLING_SENSOR_STALE_SECONDS=120

# Valeur de secours de débit uniquement pour estimation énergétique éventuelle.
# 0 = aucun débit supposé, donc puissance non calculable.
GEOCOOLING_FLOW_RATE_L_MIN=0
# Fraîcheur maximale d'un snapshot thermique en fonctionnement réel.
GEOCOOLING_THERMAL_MAX_AGE_SECONDS=180

# Confirmation humaine finale après essais physiques EV puis M11/M13.
GEOCOOLING_FIELD_CERTIFICATION_CONFIRMED=false

# =====================================================
# DIGITAL TWIN / BUILDING STATE — SPRINT 006.2A
# =====================================================
BUILDING_REFRESH_INTERVAL_SECONDS=
BUILDING_INDOOR_MAX_AGE_SECONDS=
BUILDING_WEATHER_MAX_AGE_SECONDS=

# Sprint 006.2B — Device Framework
DEVICE_REFRESH_INTERVAL_SECONDS=
DEVICE_HEARTBEAT_TIMEOUT_SECONDS=

# Sprint 006.2C — Internal Event Bus
EVENT_BUS_QUEUE_SIZE=
EVENT_BUS_HISTORY_SIZE=
EVENT_BUS_BATCH_SIZE=
EVENT_BUS_FLUSH_SECONDS=
COMPOSE_FILE=

# PATCH C018 — Waveshare Modbus TCP (désarmé par défaut)
GEOCOOLING_WAVESHARE_HOST=
GEOCOOLING_WAVESHARE_PORT=502
GEOCOOLING_WAVESHARE_UNIT_ID=1
GEOCOOLING_WAVESHARE_ADDRESS_BASE=0
GEOCOOLING_WAVESHARE_VALVE_RELAY=1
GEOCOOLING_WAVESHARE_PUMP_RELAY=2
GEOCOOLING_WAVESHARE_TIMEOUT_SECONDS=
GEOCOOLING_WAVESHARE_RETRIES=
GEOCOOLING_WAVESHARE_RETRY_DELAY_SECONDS=
GEOCOOLING_WAVESHARE_VERIFY_WRITES=true

# Sécurité : aucune commande ON autorisée pendant le commissioning
GEOCOOLING_HARDWARE_ARMED=false
GEOCOOLING_HARDWARE_SEQUENCE_ENABLED=false
GEOCOOLING_AUTOPILOT_ENABLED=false
GEOCOOLING_AUTOPILOT_ALLOW_REAL_DRIVER=false
GEOCOOLING_SEQUENCE_DELAY_SECONDS=
GEOCOOLING_VERIFY_RELAY_STATE=
